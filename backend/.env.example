APP_NAME=Intelligent Code Review & Security Vulnerability Detection
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- AI layer ---
# Put real keys in backend/.env only. Never commit them or put them in this file.
# AI_PROVIDER: auto (use whichever key is set) | anthropic | openai_compatible | none
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MAX_TOKENS_PARAM=max_tokens
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=3000

# Leave empty to use backend/data/codeshield.db
DATABASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
